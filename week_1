# visualization 2: distribution of stars
bins = [0, 10, 50, 100, 500, 1000, 5000, float("inf")]
labels = ["0–10", "11–50", "51–100", "101–500",
          "501–1,000", "1,001–5,000", "5,001+"]

star_ranges = pd.cut(
    df["stars"],
    bins=bins,
    labels=labels,
    include_lowest=True
)
star_counts = star_ranges.value_counts().sort_index()
print(star_counts)
star_counts.plot(kind="bar")
plt.title("Distribution of GitHub Stars")
plt.xlabel("Star Range")
plt.ylabel("Number of Repositories")
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
